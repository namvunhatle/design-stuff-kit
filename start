#!/usr/bin/env python3
"""Install the kit in a Claude Code project and begin its design onboarding."""

import argparse
import getpass
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent
EXTERNAL = ("ux-designer", "ui-designer", "ux-copywriter", "interactive-prototype", "figma-console-api")
VENV = ROOT / ".venv"
VENV_BIN = VENV / ("Scripts" if os.name == "nt" else "bin")


def ensure_gdown(requested: str) -> str:
    """Return a gdown executable, installing it into the kit's own .venv if needed."""
    found = shutil.which(requested)
    if found:
        return found
    local = VENV_BIN / "gdown"
    if local.is_file():
        return str(local)
    if sys.version_info < (3, 10):
        sys.exit("Python 3.10 or newer is needed. Install it from https://www.python.org/downloads/ and run ./start again.")
    print("Installing the downloader (gdown) into the kit's .venv folder. This happens once…", flush=True)
    try:
        subprocess.run([sys.executable, "-m", "venv", str(VENV)], check=True)
        subprocess.run([str(VENV_BIN / "python"), "-m", "pip", "install", "--quiet", "gdown"], check=True)
    except subprocess.CalledProcessError:
        sys.exit("Could not install gdown automatically. See docs/TROUBLESHOOTING.md, section \"gdown\".")
    return str(local)


def stage_templates(project: Path) -> None:
    """Keep optional rules, agents, and project templates available without activating them."""
    staging = project / ".claude" / "design-kit-templates"
    for kind in ("rules", "agents"):
        destination = staging / kind
        destination.mkdir(parents=True, exist_ok=True)
        for source in sorted((ROOT / kind).glob("*.md")):
            target = destination / source.name
            if not target.exists():
                shutil.copy2(source, target)
    for source in sorted((ROOT / "templates").rglob("*")):
        target = staging / source.relative_to(ROOT / "templates")
        if source.is_file() and not target.exists():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)


def connect_figma(claude: str) -> None:
    """Offer to add the Figma Console connector for this user, once."""
    if subprocess.run([claude, "mcp", "get", "figma-console"], capture_output=True).returncode == 0:
        print("\nFigma connector already set up.")
        return
    print("\nConnect Figma now? You need a Figma personal access token (starts with figd_).")
    print("How to create one: docs/FIGMA_SETUP.md, step 1. Press Return to skip; you can run ./start again later.")
    token = getpass.getpass("Paste token (hidden): ").strip()
    if not token:
        print("Skipped Figma. Copy, planning, and coded prototypes still work.")
        return
    if not token.startswith("figd_"):
        print("That doesn't look like a Figma token (it should start with figd_). Skipped; run ./start again to retry.")
        return
    if shutil.which("npx") is None:
        print("Node.js is missing, so the Figma connector can't run. Install the LTS version from https://nodejs.org, then run ./start again.")
        return
    command = [claude, "mcp", "add", "figma-console", "-s", "user",
               "-e", f"FIGMA_ACCESS_TOKEN={token}", "-e", "ENABLE_MCP_APPS=true",
               "--", "npx", "-y", "figma-console-mcp@latest"]
    if subprocess.run(command, capture_output=True).returncode:
        print("Could not add the Figma connector. Follow docs/FIGMA_SETUP.md, step 2, instead.")
        return
    print("Figma connector added for your account (not saved in the project).")
    print("Last step, in Figma Desktop: import the Desktop Bridge plugin. See docs/FIGMA_SETUP.md, step 3.")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project", type=Path, help="Existing design project (asked if omitted)")
    parser.add_argument("--gdown", default="gdown", help="Path to gdown executable")
    parser.add_argument("--no-launch", action="store_true", help="Set up files without opening Claude Code")
    parser.add_argument("--skip-figma", action="store_true", help="Don't offer to connect Figma")
    args = parser.parse_args()

    if args.project is None:
        if not sys.stdin.isatty():
            parser.error("Pass --project when running without an interactive terminal")
        answer = input("Path to your design project: ").strip()
        if not answer:
            parser.error("A project path is required")
        args.project = Path(answer)

    project = args.project.expanduser().resolve()
    if not project.is_dir():
        parser.error(f"Project directory does not exist: {project}")
    if project == ROOT or ROOT in project.parents:
        parser.error("Choose your design project, outside the product-design-agent-kit folder")

    skills = project / ".claude" / "skills"
    has_external = all((skills / name / "SKILL.md").is_file() for name in EXTERNAL)
    if has_external:
        command = [sys.executable, str(ROOT / "scripts" / "assemble.py"), "--project", str(project)]
    else:
        gdown = ensure_gdown(args.gdown)
        command = [sys.executable, str(ROOT / "scripts" / "install.py"), "--project", str(project), "--gdown", gdown]
    if subprocess.run(command).returncode:
        sys.exit("\nSetup stopped before changing your project. See docs/TROUBLESHOOTING.md for the message above.")
    stage_templates(project)

    print("\nOptional rules, agents, project-memory templates, and an MCP example are ready in .claude/design-kit-templates/.")
    if not (project / "CLAUDE.md").is_file() or not (project / "SETUP.md").is_file():
        print("One or both standard context files are missing. /start-design will check for equivalent context and guide setup if needed.")
    else:
        print("Project context found. /start-design will review it and help choose your first track.")

    claude = shutil.which("claude")
    if claude and not args.skip_figma and sys.stdin.isatty():
        connect_figma(claude)
    if args.no_launch or claude is None or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(f"\nNext: cd {shlex.quote(str(project))} && claude '/start-design'")
        if claude is None:
            print("Install Claude Code first: https://code.claude.com/docs/en/overview")
        return
    print("\nOpening Claude Code with /start-design…", flush=True)
    subprocess.run([claude, "/start-design"], cwd=project, check=True)


if __name__ == "__main__":
    main()
