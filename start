#!/usr/bin/env python3
"""Install the kit in a Claude Code project and begin its design onboarding."""

import argparse
import getpass
import os
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path


ROOT = Path(__file__).resolve().parent
EXTERNAL = ("ux-designer", "ui-designer", "ux-copywriter", "interactive-prototype", "figma-console-api")
VENV = ROOT / ".venv"
VENV_BIN = VENV / ("Scripts" if os.name == "nt" else "bin")


def ensure_gdown(requested: str) -> str:
    """Return a gdown executable, installing it into the kit's own .venv if needed."""
    found = shutil.which(requested)
    if found:
        return found
    local = VENV_BIN / "gdown"
    if local.is_file():
        return str(local)
    if sys.version_info < (3, 10):
        sys.exit("Python 3.10 or newer is needed. Install it from https://www.python.org/downloads/ and run ./start again.")
    print("Installing the downloader (gdown) into the kit's .venv folder. This happens once…", flush=True)
    try:
        subprocess.run([sys.executable, "-m", "venv", str(VENV)], check=True)
        subprocess.run([str(VENV_BIN / "python"), "-m", "pip", "install", "--quiet", "gdown"], check=True)
    except subprocess.CalledProcessError:
        sys.exit("Could not install gdown automatically. See docs/TROUBLESHOOTING.md, section \"gdown\".")
    return str(local)


MARKETPLACE = "product-design-agent-kit"
PLUGIN = "design-kit"
DEFAULT_SOURCE = "namvunhatle/product-design-agent-kit"
KIT_SKILLS = sorted(p.name for p in (ROOT / "skills").iterdir() if (p / "SKILL.md").is_file())
KIT_AGENTS = sorted(p.name for p in (ROOT / "agents").glob("*.md"))
KIT_COMMANDS = sorted(p.name for p in (ROOT / "commands").glob("*.md"))


def old_copies(project: Path) -> list:
    """Kit files copied into the project by the pre-plugin setup. They now duplicate the plugin."""
    claude_dir = project / ".claude"
    found = [claude_dir / "skills" / n for n in KIT_SKILLS if (claude_dir / "skills" / n).is_dir()]
    found += [claude_dir / "agents" / n for n in KIT_AGENTS if (claude_dir / "agents" / n).is_file()]
    found += [claude_dir / "commands" / n for n in KIT_COMMANDS if (claude_dir / "commands" / n).is_file()]
    return found


def migrate_old_copies(project: Path) -> None:
    found = old_copies(project)
    if not found:
        return
    claude_dir = project / ".claude"
    print("\nThis project has copies of kit files from the old setup. The plugin now provides them:")
    for path in found:
        print(f"  {path.relative_to(project)}")
    backup = claude_dir / "design-kit-backup" / time.strftime("%Y%m%d-%H%M%S")
    if not sys.stdin.isatty():
        print(f"Move them into {backup.relative_to(project)}/ (keeps any local edits), or run ./start again in a terminal to do it for you.")
        return
    if input(f"Move them into {backup.relative_to(project)}/? Local edits are kept there. [y/N] ").strip().lower() != "y":
        print("Left in place. Claude Code will show both the old copies and the plugin's versions until you move them.")
        return
    for path in found:
        target = backup / path.relative_to(claude_dir)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(path), str(target))
    print(f"Moved. Compare with the plugin's versions if you had edited any of them.")


def install_plugin(claude: str, project: Path, source: str) -> bool:
    """Register the kit's marketplace for this project and install the plugin at project scope."""
    # Always declare it in the project's settings, even when this machine already knows the
    # marketplace: the declaration is what offers the plugin to teammates. Adding again is safe.
    added = subprocess.run([claude, "plugin", "marketplace", "add", source, "--scope", "project"], cwd=project, capture_output=True, text=True)
    if added.returncode:
        print(added.stdout + added.stderr)
        return False
    installed = subprocess.run([claude, "plugin", "install", f"{PLUGIN}@{MARKETPLACE}", "--scope", "project"], cwd=project, capture_output=True, text=True)
    if installed.returncode and "already installed" not in (installed.stdout + installed.stderr).lower():
        print(installed.stdout + installed.stderr)
        return False
    print(f"\nInstalled the {PLUGIN} plugin for this project (declared in .claude/settings.json, so teammates are offered it too).")
    print("To get kit updates automatically: in Claude Code run /plugin, open Marketplaces, select")
    print(f"{MARKETPLACE}, and choose Enable auto-update. Otherwise run /plugin marketplace update {MARKETPLACE}.")
    return True


def connect_figma(claude: str) -> None:
    """Offer to add the Figma Console connector for this user, once."""
    if subprocess.run([claude, "mcp", "get", "figma-console"], capture_output=True).returncode == 0:
        print("\nFigma connector already set up.")
        return
    print("\nConnect Figma now? You need a Figma personal access token (starts with figd_).")
    print("How to create one: docs/FIGMA_SETUP.md, step 1. Press Return to skip; you can run ./start again later.")
    token = getpass.getpass("Paste token (hidden): ").strip()
    if not token:
        print("Skipped Figma. Copy, planning, and coded prototypes still work.")
        return
    if not token.startswith("figd_"):
        print("That doesn't look like a Figma token (it should start with figd_). Skipped; run ./start again to retry.")
        return
    if shutil.which("npx") is None:
        print("Node.js is missing, so the Figma connector can't run. Install the LTS version from https://nodejs.org, then run ./start again.")
        return
    command = [claude, "mcp", "add", "figma-console", "-s", "user",
               "-e", f"FIGMA_ACCESS_TOKEN={token}", "-e", "ENABLE_MCP_APPS=true",
               "--", "npx", "-y", "figma-console-mcp@latest"]
    if subprocess.run(command, capture_output=True).returncode:
        print("Could not add the Figma connector. Follow docs/FIGMA_SETUP.md, step 2, instead.")
        return
    print("Figma connector added for your account (not saved in the project).")
    print("Last step, in Figma Desktop: import the Desktop Bridge plugin. See docs/FIGMA_SETUP.md, step 3.")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project", type=Path, help="Existing design project (asked if omitted)")
    parser.add_argument("--gdown", default="gdown", help="Path to gdown executable")
    parser.add_argument("--no-launch", action="store_true", help="Set up files without opening Claude Code")
    parser.add_argument("--skip-figma", action="store_true", help="Don't offer to connect Figma")
    parser.add_argument("--marketplace", default=DEFAULT_SOURCE, help="Where to install the plugin from: a GitHub owner/repo, git URL, or local path (default: %(default)s)")
    parser.add_argument("--agents", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.agents:
        print("Note: --agents is no longer needed. The kit's agents come with the plugin.")

    if args.project is None:
        if not sys.stdin.isatty():
            parser.error("Pass --project when running without an interactive terminal")
        answer = input("Path to your design project: ").strip()
        if not answer:
            parser.error("A project path is required")
        args.project = Path(answer)

    project = args.project.expanduser().resolve()
    if not project.is_dir():
        parser.error(f"Project directory does not exist: {project}")
    if project == ROOT or ROOT in project.parents:
        parser.error("Choose your design project, outside the product-design-agent-kit folder")

    skills = project / ".claude" / "skills"
    has_external = all((skills / name / "SKILL.md").is_file() for name in EXTERNAL)
    if has_external:
        command = [sys.executable, str(ROOT / "scripts" / "assemble.py"), "--project", str(project)]
    else:
        gdown = ensure_gdown(args.gdown)
        command = [sys.executable, str(ROOT / "scripts" / "install.py"), "--project", str(project), "--gdown", gdown]
    if subprocess.run(command).returncode:
        sys.exit("\nSetup stopped before changing your project. See docs/TROUBLESHOOTING.md for the message above.")
    claude = shutil.which("claude")
    if claude is None or not install_plugin(claude, project, args.marketplace):
        print("\nThe plugin is not installed yet. In Claude Code, inside your project, run:")
        print(f"  /plugin marketplace add {args.marketplace}")
        print(f"  /plugin install {PLUGIN}@{MARKETPLACE}")
    migrate_old_copies(project)

    print("\nOptional rules, project-memory templates, and an MCP example are in the plugin; /design-kit:start-design offers them.")
    if not (project / "CLAUDE.md").is_file() or not (project / "SETUP.md").is_file():
        print("One or both standard context files are missing. /design-kit:start-design will check for equivalent context and guide setup if needed.")
    else:
        print("Project context found. /design-kit:start-design will review it and help choose your first track.")

    if claude and not args.skip_figma and sys.stdin.isatty():
        connect_figma(claude)
    if args.no_launch or claude is None or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(f"\nNext: cd {shlex.quote(str(project))} && claude '/{PLUGIN}:start-design'")
        if claude is None:
            print("Install Claude Code first: https://code.claude.com/docs/en/overview")
        return
    print(f"\nOpening Claude Code with /{PLUGIN}:start-design…", flush=True)
    subprocess.run([claude, f"/{PLUGIN}:start-design"], cwd=project, check=True)


if __name__ == "__main__":
    main()
